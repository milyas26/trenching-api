# PumpPortal Lightning API (mode real)
PUMPPORTAL_API_KEY=
# Ditampilkan di app saat mode real
WALLET_PUBLIC_KEY=
# RPC untuk cek saldo wallet (default RPC publik mainnet, rate limit ketat)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

DATABASE_URL=postgresql://user@localhost:5432/micin-agent

# Maksimal koneksi Postgres dari api ini (default 5)
# DB_POOL_MAX=5

# Server
HOST=0.0.0.0
PORT=3001
# Origin app yang boleh akses, dipisah koma. Kosong = semua origin.
CORS_ORIGIN=

# Scanner GMGN (butuh: pip install -r requirements.txt)
PYTHON_BIN=python3
# GMGN_SCRIPT=scripts/gmgn_hot_searches.py
