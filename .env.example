# PumpPortal Lightning API (mode real). Dipakai akun yang tidak mengisi API key/wallet sendiri di Pengaturan.
PUMPPORTAL_API_KEY=
# Ditampilkan di app saat mode real
WALLET_PUBLIC_KEY=
# RPC untuk cek saldo wallet (default RPC publik mainnet, rate limit ketat)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# WebSocket untuk push harga posisi open (default: SOLANA_RPC_URL dengan http diganti ws)
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# AI agent yang meninjau token sebelum buy (bisa dimatikan di Pengaturan)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

DATABASE_URL=postgresql://user@localhost:5432/micin-agent

# Maksimal koneksi Postgres dari api ini (default 5)
# DB_POOL_MAX=5

# Server
HOST=0.0.0.0
PORT=3001
# Origin app yang boleh akses, dipisah koma. Kosong = semua origin.
CORS_ORIGIN=

# Scanner GMGN (butuh: pip install -r requirements.txt)
PYTHON_BIN=python3
# GMGN_SCRIPT=scripts/gmgn_hot_searches.py
# GMGN_TRENDING_SCRIPT=scripts/gmgn_trending.py
