generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TradeMode {
  paper
  real
}

enum PositionStatus {
  opening
  open
  closing
  closed
  failed
}

enum ExitReason {
  take_profit
  stop_loss
  stop_loss_mc
  trailing_stop
  max_hold
  manual
}

enum LogLevel {
  info
  warn
  error
  buy
  sell
}

/// Satu bot dengan pengaturan, posisi, dan wallet sendiri.
model Account {
  id               Int             @id @default(autoincrement())
  name             String
  /// BotSettings (lihat settings.schema.ts) sebagai JSON.
  settings         Json
  /// PumpPortal Lightning API key untuk mode real; null = pakai PUMPPORTAL_API_KEY dari .env.
  pumpportalApiKey String?         @map("pumpportal_api_key")
  /// null = pakai WALLET_PUBLIC_KEY dari .env.
  walletPublicKey  String?         @map("wallet_public_key")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  positions        Position[]
  logs             Log[]
  snapshots        TokenSnapshot[]
  scans            GmgnScan[]

  @@map("accounts")
}

model Position {
  id            Int            @id @default(autoincrement())
  accountId     Int            @map("account_id")
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mode          TradeMode
  mint          String
  symbol        String?
  name          String?
  logo          String?
  status        PositionStatus
  amountSol     Float          @map("amount_sol")
  entryPrice    Float?         @map("entry_price")
  entryMc       Float?         @map("entry_mc")
  /// Supply token (market cap / harga) saat entry; dipakai untuk menurunkan market cap dari harga.
  supply        Float?
  /// Kolom Token Info GMGN (TokenInfo) saat token dibeli.
  tokenInfo     Json?          @map("token_info")
  /// Take profit khusus posisi ini (aturan token OG); null = pakai take profit akun.
  takeProfitPct Float?         @map("take_profit_pct")
  currentPrice  Float?         @map("current_price")
  highPrice     Float?         @map("high_price")
  /// Harga terendah selama posisi open; null untuk posisi yang ditutup sebelum kolom ini ada.
  lowPrice      Float?         @map("low_price")
  pnlPct        Float?         @map("pnl_pct")
  exitPrice     Float?         @map("exit_price")
  exitReason    ExitReason?    @map("exit_reason")
  pnlSol        Float?         @map("pnl_sol")
  buySignature  String?        @map("buy_signature")
  sellSignature String?        @map("sell_signature")
  sellAttempts  Int            @default(0) @map("sell_attempts")
  error         String?
  openedAt      DateTime       @default(now()) @map("opened_at")
  closedAt      DateTime?      @map("closed_at")
  priceUpdatedAt DateTime?     @map("price_updated_at")

  @@unique([accountId, mode, mint])
  @@index([status])
  @@map("positions")
}

model Log {
  id        BigInt   @id @default(autoincrement())
  /// null = log sistem yang tidak terkait satu akun (mis. cek harga semua posisi).
  accountId Int?     @map("account_id")
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  level     LogLevel
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@map("logs")
}

enum SnapshotDecision {
  buy
  skip
  error
  no_ai
}

/// Data lengkap token saat bot memutuskan buy/skip, untuk analisa. Join ke positions lewat (mode, mint).
model TokenSnapshot {
  id             Int              @id @default(autoincrement())
  accountId      Int              @map("account_id")
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mode           TradeMode
  mint           String
  symbol         String?
  decision       SnapshotDecision
  confidence     Int?
  reason         String?
  /// Kenaikan harga dari sampel pertama ke recheck terakhir, dalam persen.
  recheckGainPct Float?           @map("recheck_gain_pct")
  /// Objek mentah GMGN (hot_searches atau trending), semua field.
  gmgn           Json
  /// Data pair DexScreener saat keputusan (review AI atau buy tanpa AI).
  market         Json?
  chart          Json?
  priceSamples   Json?            @map("price_samples")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([mint])
  @@index([createdAt])
  @@map("token_snapshots")
}

/// Satu panggilan GMGN per scan bot.
model GmgnScan {
  id         Int         @id @default(autoincrement())
  accountId  Int         @map("account_id")
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// hot_searches | trending
  source     String      @default("hot_searches")
  /// Filter yang dikirim bot ke GMGN.
  filter     Json
  /// Seluruh response GMGN kecuali daftar token (code, message, interval, chain, filter_id, version, ...).
  response   Json
  tokenCount Int         @map("token_count")
  createdAt  DateTime    @default(now()) @map("created_at")
  tokens     GmgnToken[]

  @@index([accountId])
  @@index([createdAt])
  @@map("gmgn_scans")
}

/// Satu token dari satu scan GMGN, objek mentah apa adanya.
model GmgnToken {
  id        Int      @id @default(autoincrement())
  scanId    Int      @map("scan_id")
  scan      GmgnScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  mint      String
  symbol    String?
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([mint])
  @@index([scanId])
  @@index([createdAt])
  @@map("gmgn_tokens")
}
